# --- Site ---
NEXT_PUBLIC_SITE_URL=https://goldenstatebarbershop.com
NEXT_PUBLIC_BUSINESS_NAME="Golden State Barbershop"

# --- Stripe (payments: online + customer wallet Apple/Google Pay) ---
STRIPE_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Postgres (bookings, receipts, review requests) ---
# Provision via: vercel integration add neon   (or any Marketplace Postgres)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Resend (digital receipts + auto review requests) ---
RESEND_API_KEY=re_xxx
RECEIPT_FROM_EMAIL="Golden State Barbershop <hello@goldenstatebarbershop.com>"

# --- Storefront (public, build-time) ---
# Amazon Associates store ID. Product links earn nothing until set.
NEXT_PUBLIC_AMAZON_TAG=
# Shown on the order confirmation page when set
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
# Set to 1 once a real card processor is connected
NEXT_PUBLIC_PAYMENTS_LIVE=
# Preview-only switches (leave unset in production)
NEXT_PUBLIC_PREVIEW_MODE=
NEXT_PUBLIC_SEED_DEMO=

# --- Reviews ---
# Google "Write a review" deep link (from Google Place ID)
GOOGLE_REVIEW_URL=https://g.page/r/XXXXXXXX/review
