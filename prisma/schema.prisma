generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  priceCents  Int
  minutes     Int       @default(30)
  active      Boolean   @default(true)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
}

model Barber {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  active    Boolean   @default(true)
  bookings  Booking[]
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String?
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Booking {
  id            String        @id @default(cuid())
  service       Service       @relation(fields: [serviceId], references: [id])
  serviceId     String
  barber        Barber?       @relation(fields: [barberId], references: [id])
  barberId      String?
  customer      Customer      @relation(fields: [customerId], references: [id])
  customerId    String
  startsAt      DateTime
  endsAt        DateTime
  status        BookingStatus @default(PENDING)
  // Payment
  amountCents   Int
  stripePaymentIntentId String? @unique
  paidAt        DateTime?
  // Post-visit automation
  receiptSentAt DateTime?
  reviewSentAt  DateTime?
  createdAt     DateTime      @default(now())

  @@index([startsAt])
  @@index([status])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PAID
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ---- Accounts ---------------------------------------------------------------
// Passwords are scrypt hashes (lib/auth/password.ts). Sessions are random
// tokens in an httpOnly cookie; only the SHA-256 of the token is stored here.

enum Role {
  CUSTOMER
  BARBER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  role         Role      @default(CUSTOMER)
  onboarded    Boolean   @default(false)
  cutsHair     Boolean   @default(false)
  // Barber profile
  specialties  String?
  bio          String?
  privateRate  Float?
  passwordHash String
  sessions     Session[]
  createdAt    DateTime  @default(now())

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// One-time barber invite codes created by the owner.
model Invite {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  usedBy    String? // email that redeemed it
  createdAt DateTime @default(now())
}
